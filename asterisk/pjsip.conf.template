; Plantilla renderizada por el entrypoint de la imagen con variables de .env.
[transport-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
external_media_address=${ASTERISK_PUBLIC_IP}
external_signaling_address=${ASTERISK_PUBLIC_IP}
external_signaling_port=5061
cert_file=/etc/asterisk/keys/server.crt
priv_key_file=/etc/asterisk/keys/server.key
method=tlsv1_2
verify_client=no
require_client_cert=no
tos=cs3

; WebSocket interno; Nginx lo expone como WSS por el mismo TLS de 8443.
[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0:8088
external_media_address=${ASTERISK_PUBLIC_IP}
external_signaling_address=${ASTERISK_PUBLIC_IP}
external_signaling_port=8443

[100]
type=endpoint
transport=transport-tls
context=internal
disallow=all
allow=opus,ulaw,alaw
auth=auth-100
aors=100
callerid="Prueba 100" <100>
media_encryption=sdes
media_encryption_optimistic=no
direct_media=no
rewrite_contact=yes
force_rport=yes
rtp_symmetric=yes
dtmf_mode=rfc4733
device_state_busy_at=1
tos_audio=ef
cos_audio=5

[auth-100]
type=auth
auth_type=userpass
username=100
password=${SIP_PASSWORD_100}

[100]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

[101]
type=endpoint
transport=transport-tls
context=internal
disallow=all
allow=opus,ulaw,alaw
auth=auth-101
aors=101
callerid="Prueba 101" <101>
media_encryption=sdes
media_encryption_optimistic=no
direct_media=no
rewrite_contact=yes
force_rport=yes
rtp_symmetric=yes
dtmf_mode=rfc4733
device_state_busy_at=1
tos_audio=ef
cos_audio=5

[auth-101]
type=auth
auth_type=userpass
username=101
password=${SIP_PASSWORD_101}

[101]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

; Perfiles de dispositivo WebRTC de las mismas extensiones lógicas 100/101.
; El navegador exige DTLS-SRTP; no es intercambiable con SDES en un endpoint.
[1100]
type=endpoint
transport=transport-ws
context=internal
disallow=all
allow=opus,ulaw,alaw
auth=auth-1100
aors=1100
callerid="Web 100" <100>
webrtc=yes
from_domain=nexo.local
media_address=${ASTERISK_PUBLIC_IP}
media_encryption=dtls
media_encryption_optimistic=no
dtls_cert_file=/etc/asterisk/keys/server.crt
dtls_private_key=/etc/asterisk/keys/server.key
dtls_verify=fingerprint
dtls_setup=actpass
ice_support=yes
rtcp_mux=yes
use_avpf=yes
bundle=yes
direct_media=no
rewrite_contact=yes
force_rport=yes
rtp_symmetric=yes
dtmf_mode=rfc4733
device_state_busy_at=1
tos_audio=ef
cos_audio=5

[auth-1100]
type=auth
auth_type=userpass
username=1100
password=${WEBRTC_PASSWORD_100}

[1100]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=0

