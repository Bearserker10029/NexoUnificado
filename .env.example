# Copiar como .env. Solo las cuentas de administrador tienen credenciales aqui;
# los usuarios finales se crean desde la consola de Keycloak, no en este archivo.
NEXO_HOST=127.0.0.1

# Administradores tecnicos existentes.
KC_ADMIN_USER=nexo_admin
KC_ADMIN_PASSWORD=CAMBIAR_Keycloak_2026!
NC_ADMIN_USER=nexo_admin
NC_ADMIN_PASSWORD=CAMBIAR_Nextcloud_2026!
GRAFANA_USER=admin
GRAFANA_PASSWORD=CAMBIAR_Grafana_2026!

# Secretos internos de servicios y clientes OIDC (no son cuentas de usuario).
KC_NEXTCLOUD_CLIENT_SECRET=CAMBIAR_ClienteNextcloud_2026!
KC_SYNAPSE_CLIENT_SECRET=CAMBIAR_ClienteSynapse_2026!
KC_VOIP_CLIENT_SECRET=CAMBIAR_ClienteVoip_2026!
VOIP_SESSION_SECRET=CAMBIAR_SesionVoip_2026!
VOIP_AMI_USER=voip_gateway
VOIP_AMI_SECRET=CAMBIAR_AMIVoip_2026!
JICOFO_AUTH_PASSWORD=CAMBIAR_Jicofo_2026!
JICOFO_COMPONENT_SECRET=CAMBIAR_JicofoComponente_2026!
JVB_AUTH_PASSWORD=CAMBIAR_Jvb_2026!
NC_DB_ROOT_PASSWORD=CAMBIAR_NCDBRoot_2026!
NC_DB_PASSWORD=CAMBIAR_NCDB_2026!
