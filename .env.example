# Copiar como .env y reemplazar todos los valores antes de levantar el laboratorio.
# No reutilizar estas claves de documentación en un entorno real.

# Variable unica de host: IP o nombre del equipo de laboratorio. Para clientes
# en esta misma PC: 127.0.0.1 o localhost. En otro equipo/red: la IP del host
# Docker. Todo lo demas (Element, Keycloak, Nextcloud, Jitsi, Asterisk) se
# deriva de este valor al reiniciar con "docker compose up -d"; ver README >
# "Cambio de IP o de nombre de host".
NEXO_HOST=127.0.0.1

GRAFANA_USER=admin
GRAFANA_PASSWORD=CAMBIAR_Grafana_2026!
SIP_PASSWORD_100=CAMBIAR_SIP100_2026!x7Q
SIP_PASSWORD_101=CAMBIAR_SIP101_2026!p9L
WEBRTC_PASSWORD_100=CAMBIAR_WEB100_2026!m4R
WEBRTC_PASSWORD_101=CAMBIAR_WEB101_2026!k8T
# H6: videoconferencia (Jitsi Meet)
JICOFO_AUTH_PASSWORD=CAMBIAR_Jicofo_2026!
JICOFO_COMPONENT_SECRET=CAMBIAR_JicofoComponente_2026!
JVB_AUTH_PASSWORD=CAMBIAR_Jvb_2026!

# H9: identidad unica (Keycloak) y menu unificado (Nextcloud)
KC_ADMIN_USER=nexo_admin
KC_ADMIN_PASSWORD=CAMBIAR_Keycloak_2026!
# Clientes OIDC del realm "nexo" (ver keycloak/realm-nexo.json.template)
KC_NEXTCLOUD_CLIENT_SECRET=CAMBIAR_ClienteNextcloud_2026!
KC_SYNAPSE_CLIENT_SECRET=CAMBIAR_ClienteSynapse_2026!
# Dos usuarios de prueba precargados en el realm, con TOTP obligatorio al primer ingreso
KC_TEST_USER1_USERNAME=usuario1
KC_TEST_USER1_PASSWORD=CAMBIAR_Usuario1_2026!
KC_TEST_USER2_USERNAME=usuario2
KC_TEST_USER2_PASSWORD=CAMBIAR_Usuario2_2026!

NC_DB_ROOT_PASSWORD=CAMBIAR_NCDBRoot_2026!
NC_DB_PASSWORD=CAMBIAR_NCDB_2026!
NC_ADMIN_USER=nexo_admin
NC_ADMIN_PASSWORD=CAMBIAR_Nextcloud_2026!
