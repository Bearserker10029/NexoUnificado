{
  "realm": "nexo",
  "enabled": true,
  "displayName": "Nexo Unificado",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "requiredCredentials": ["password"],
  "clients": [
    {
      "clientId": "nextcloud",
      "name": "Nextcloud (menu unificado)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_NEXTCLOUD_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${NEXO_URL}/docs/apps/user_oidc/code*"],
      "webOrigins": ["${NEXO_URL}"],
      "rootUrl": "${NEXO_URL}",
      "baseUrl": "/docs/",
      "attributes": {
        "post.logout.redirect.uris": "${NEXO_URL}/docs/*"
      }
    },
    {
      "clientId": "synapse",
      "name": "Matrix Synapse (chat Element)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_SYNAPSE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${NEXO_URL}/_synapse/client/oidc/callback"],
      "webOrigins": ["${NEXO_URL}"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "voip",
      "name": "Telefonia WebRTC",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_VOIP_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${NEXO_URL}/voip-sso/callback"],
      "webOrigins": ["${NEXO_URL}"],
      "rootUrl": "${NEXO_URL}/voip/",
      "baseUrl": "/voip/",
      "attributes": {
        "post.logout.redirect.uris": "${NEXO_URL}/voip/*",
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
