
# Synapse exige HTTPS en todos los endpoints OIDC. Las llamadas internas
# atraviesan Nginx y confían explícitamente en el certificado del laboratorio.
oidc_providers:
  - idp_id: keycloak
    idp_name: "Nexo Unificado"
    issuer: "${NEXO_URL}/keycloak/realms/nexo"
    discover: false
    authorization_endpoint: "${NEXO_URL}/keycloak/realms/nexo/protocol/openid-connect/auth"
    token_endpoint: "${NEXO_URL}/keycloak/realms/nexo/protocol/openid-connect/token"
    userinfo_endpoint: "${NEXO_URL}/keycloak/realms/nexo/protocol/openid-connect/userinfo"
    jwks_uri: "${NEXO_URL}/keycloak/realms/nexo/protocol/openid-connect/certs"
    client_id: "synapse"
    client_secret: "${KC_SYNAPSE_CLIENT_SECRET}"
    scopes: ["openid", "profile", "email"]
    user_mapping_provider:
      config:
        localpart_template: "{{ user.preferred_username }}"
        display_name_template: "{{ user.name }}"

# Element es un cliente propio de la plataforma: no requiere una segunda
# confirmacion para concederle acceso a la cuenta Matrix despues del OIDC.
sso:
  client_whitelist:
    - "${NEXO_URL}/element/"
