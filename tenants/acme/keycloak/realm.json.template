{
  "realm": "nexo-acme",
  "enabled": true,
  "displayName": "ACME",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    {
      "name": "acme-servicio-chat"
    },
    {
      "name": "acme-servicio-telefonia"
    },
    {
      "name": "acme-servicio-videoconferencia"
    },
    {
      "name": "acme-administradores",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "nextcloud",
      "name": "Nextcloud acme",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_NEXTCLOUD_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${NEXO_URL}/docs/apps/user_oidc/code*"
      ],
      "webOrigins": [
        "${NEXO_URL}"
      ],
      "rootUrl": "${NEXO_URL}",
      "baseUrl": "/docs/",
      "attributes": {
        "post.logout.redirect.uris": "${NEXO_URL}/docs/*"
      },
      "protocolMappers": [
        {
          "name": "grupos-servicios",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nexo-portal",
      "name": "Servicios Nexo acme",
      "enabled": true,
      "optionalClientScopes": [
        "offline_access",
        "microprofile-jwt",
        "kc-admin-api"
      ],
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_VOIP_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${NEXO_URL}/voip-sso/acme/callback"
      ],
      "webOrigins": [
        "${NEXO_URL}"
      ],
      "rootUrl": "${NEXO_URL}/acme/",
      "attributes": {
        "post.logout.redirect.uris": "${NEXO_URL}/acme/*",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "grupos-servicios",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "synapse",
      "name": "Synapse acme",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_SYNAPSE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${NEXO_URL}/acme/_synapse/client/oidc/callback"
      ],
      "webOrigins": [
        "${NEXO_URL}"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    }
  ]
}
